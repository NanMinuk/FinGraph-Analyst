# ============================================================
# FinGraph Analyst — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# ------ OpenAI ------
OPENAI_API_KEY=sk-...

# ------ Neo4j ------
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# ------ LLM Models (optional — defaults shown) ------
SUPERVISOR_MODEL=gpt-4.1-nano
EXTRACTION_MODEL=gpt-4.1-mini
ANALYSIS_MODEL=gpt-4.1-nano
EMBEDDING_MODEL=text-embedding-3-small

# ------ Vector DB paths (optional) ------
CHROMA_PATH=data/chroma_langchain
EMBED_CACHE_PATH=data/embedding_cache

# ------ Chunking (optional) ------
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ------ Confidence thresholds (optional) ------
EXTRACTION_CONFIDENCE_THRESHOLD=0.65
GRAPH_UPSERT_CONFIDENCE=0.8
POSTPROCESS_MIN_CONFIDENCE=0.75

# ------ Hybrid graph weights (optional) ------
HYBRID_CURRENT_WEIGHT=0.7
HYBRID_PERSISTENT_WEIGHT=0.3
HYBRID_UPSERT_MIN_CONFIDENCE=0.75

# ------ Neo4j query limit (optional) ------
NEO4J_GRAPH_LIMIT=20

# ------ API URL for Streamlit (optional) ------
# Set this when running Streamlit separately from FastAPI.
# In Docker Compose this is automatically set to http://api:8000.
API_URL=http://localhost:8000
